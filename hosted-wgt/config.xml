<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets" 
        id="http://kocsefa.github.io/tizendashboard" 
        version="1.0.0" 
        viewmodes="maximized">
    <tizen:application id="kocsefa001.SmartDashboard" 
                       package="kocsefa001" 
                       required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Smart Dashboard</name>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" 
                   context-menu="enable" 
                   background-support="disable" 
                   encryption="disable" 
                   install-location="auto"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation href="https://kocsefa.github.io/*"/>
    <tizen:allow-navigation href="https://*.github.io/*"/>
    <tizen:allow-navigation href="https://*.open-meteo.com/*"/>
    <tizen:allow-navigation href="https://*.aladhan.com/*"/>
    <tizen:allow-navigation href="https://*.wikimedia.org/*"/>
</widget>
